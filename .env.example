# Correo del administrador (dueño del sistema)
ADMIN_EMAIL=rafadonte@gmail.com
# Contraseña del administrador. Cámbiala aquí cuando quieras y reinicia la app.
ADMIN_PASSWORD=
# Llave para firmar las sesiones (se genera sola la primera vez)
SESSION_SECRET=
# Dónde se guarda la base de datos (SQLite)
DATABASE_PATH=.data/abasto.sqlite
# Ponlo en true SOLO si publicas la app con HTTPS (Render, Railway, tu dominio...)
COOKIE_SECURE=false
